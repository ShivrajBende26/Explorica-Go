NODE_ENV=development
PORT=3000
DATABASE=mongodb+srv://<DATABASE_USER>:<PASSWORD>@<CLUSTER_HOST>/BookTheVibe-app?retryWrites=true
DATABASE_LOCAL=mongodb://localhost:27017/BookTheVibe-app
DATABASE_PASSWORD=replace_with_your_mongodb_password

JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=INR

MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v12

EMAIL_HOST=smtp.postmarkapp.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USERNAME=replace_with_postmark_smtp_access_key
EMAIL_PASSWORD=replace_with_postmark_smtp_secret_key
EMAIL_FROM=
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
EMAIL_LOGO_URL=
