extends base

block content
  main.main
    .login-form
      p.home-kicker Your next adventure begins here
      h2.heading-secondary.ma-bt-lg Join Explorica Go
      form.form.form--signup
        .form__group
          label.form__label(for='name') Name
          input#name.form__input(type='text', required, autocomplete='name')
        .form__group
          label.form__label(for='email') Email address
          input#email.form__input(type='email', placeholder='you@example.com', required, autocomplete='email')
        .form__group
          label.form__label(for='password') Password
          input#password.form__input(type='password', required, minlength='8', autocomplete='new-password')
        .form__group.ma-bt-md
          label.form__label(for='password-confirm') Confirm password
          input#password-confirm.form__input(type='password', required, minlength='8', autocomplete='new-password')
        .form__group
          button.btn.btn--green Create account
