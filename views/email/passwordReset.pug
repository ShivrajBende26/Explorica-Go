extends baseEmail

block content
  p Hi #{firstName},
  p Use the link below to reset your password. This link expires in 10 minutes.
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') Reset your password
  p If you didn’t request a password reset, you can ignore this email.
