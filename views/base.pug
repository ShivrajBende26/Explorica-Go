doctype html
html
  head
    block head
      meta(charset='UTF-8')
      meta(name='viewport' content='width=device-width, initial-scale=1.0')
      meta(name='theme-color' content='#123d78')
      link(rel='stylesheet' href='/css/style.css')
      link(rel='icon' type='image/png' sizes='512x512' href='/img/explorica-go-favicon.png')
      link(rel='preconnect' href='https://fonts.googleapis.com')
      link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
      link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&display=swap')
      title Explorica Go | #{title}

  body(data-alert=`${alert ? alert : ''}` data-mapbox-token=mapboxAccessToken data-mapbox-style=mapboxStyle)
    // HEADER
    include _header

    // CONTENT
    block content
      h1 This is a placeholder heading

    // FOOTER
    include _footer

    script(type='module' src='/js/index.js')