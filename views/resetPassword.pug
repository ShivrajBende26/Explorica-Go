extends base

block content
  main.main
    .login-form
      h2.heading-secondary.ma-bt-lg Choose a new password
      form.form.form--reset-password(data-token=resetToken)
        .form__group
          label.form__label(for='password') New password
          input#password.form__input(type='password', required, minlength='8', autocomplete='new-password')
        .form__group.ma-bt-md
          label.form__label(for='password-confirm') Confirm new password
          input#password-confirm.form__input(type='password', required, minlength='8', autocomplete='new-password')
        .form__group
          button.btn.btn--green Reset password
